# Scanner configuration. Copy to config/scanner/.env; every non-secret value here
# is also a CLI flag. The two credential lines (SCAN_ZAP_API_KEY, SHARED_OPENROUTER_API_KEY)
# are PLACEHOLDERS: replace them in your .env, or — for the Claude-assisted setup,
# where the agent must never see the real key — put the real values in a
# gitignored secrets.env beside this file, which the loader reads LAST so it wins.
# A key is never passed on a command line and never written to a data/ artifact.

# --- target -------------------------------------------------------------
# WHICH target is the positional argument to `dast` (`dast scan wordpress`),
# and its URL and source tree come from that target's own targets/<name>/
# target.yml. They deliberately do NOT live here: this file is shared by every
# target, and naming one here silently overrode the positional — a `dast scan
# wordpress` that scanned Gitea. --target / --noir-source remain for a one-off
# override of a single run.
# One-off overrides of the resolved target, normally UNSET so the positional
# argument and targets/<name>/target.yml decide. Uncomment only to point a
# single run somewhere else.
#SCAN_TARGET_URL=http://target-gitea:3000
# none | user | admin. Runs at different modes are not comparable.
SHARED_AUTH_MODE=none
# Where the <name>/target.yml definitions and their src/ trees live. Unset = the
# sibling top-level ../Targets (the tool/targets split); a target's source_dir
# resolves within its own <name>/ dir. Set it to reach a checkout elsewhere.
# Shared by scan/triage/verify/static-analysis.
#SHARED_TARGETS_DIR=/abs/path/to/Targets

# --- scan: ZAP ----------------------------------------------------------
SCAN_ZAP_API_KEY=change-me
SCAN_ZAP_ADDR=http://localhost:8080
SCAN_ZAP_MAX_ACTIVE_SCAN_MINUTES=45
SCAN_ZAP_MAX_RULE_MINUTES=5
# query 1 / post 2 / cookie 4 / header 8 / url-path 16; 19 = query+post+path
# The daemon is always restarted before a run (there is no session-reset mode):
# a reset can leave a prior scan's state behind, so a restart is the only genuine
# fresh start — and the pipeline already runs containers, so it can.

# How ZAP is driven: `rest` (default, proven) or `af` (Automation Framework).
#
# `rest` means this pipeline sequences the scan over ZAP's REST API — the order
# is explicit in scan.py, every option it sets is visible in one place, and the
# run records what it did. That is the mode every recorded result was produced
# with.
#
# `af` hands crawling and scanning to a YAML plan instead. That is how ZAP is
# normally driven in CI, so it is the mode to demonstrate when the question is
# "how would this be deployed" — and a plan can be written in ZAP's own GUI and
# handed to someone with no knowledge of this codebase. The cost is that the
# decisions move into a file this code does not read.
#
# The two are NOT comparable runs and the mode is part of the configuration
# digest, so their run directories differ and the log states which was used.
SCAN_ZAP_MODE=rest
# The plan for SCAN_ZAP_MODE=af. `none` uses the target's own targets/<name>/zap.yml.
# A file named here that does not exist is an error, not a fall-through.
#
# Plans are deliberately NOT versioned the way prompts/ are — an AF plan is
# configuration for a tool, not a variable under study — but the file's SHA-256
# is recorded in the run so a stored result can be matched to the YAML that
# produced it after the fact.
SCAN_ZAP_PLAN=none
# The daemon's container name. Used only to deliver a plan into it with
# `docker cp`: runPlan takes a path inside the container and ZAP has no mount.
SCAN_ZAP_CONTAINER=dast-zap

# Which crawlers the scan runs, comma-separated and in order: traditional, ajax,
# client. Empty uses the target's own `spiders:` list, falling back to
# `traditional`.
#
# `traditional` parses HTML and never executes it, so an app whose links are
# built by JavaScript (a JS-driven admin surface) is largely invisible to it.
# The other two drive a real Firefox inside the ZAP container. ZAP's own
# guidance since 2026 is that `client`, not `ajax`, is the one to reach for on a
# modern app.
#
# KEEP `traditional` in any list you set: every recorded coverage number in this
# project was produced by it alone, so dropping it moves that baseline instead
# of adding to it. Order matters — each crawler adds to the tree the previous
# built.
SCAN_ZAP_SPIDERS=traditional,client
# Wall-clock cap for EITHER browser-driven crawler. Neither reports completion
# usefully: the AJAX spider is a singleton with no duration option, and the
# client spider's `status` is not monotonic — observed climbing to 93 then
# falling back to 72, because it is a ratio of done to queued work and finding
# new work moves the denominator. The client spider also stops early once the
# site tree has stopped growing for a minute; this cap is the backstop.
SCAN_ZAP_BROWSER_SPIDER_MINUTES=5

SCAN_ZAP_INJECTABLE_TARGETS=19
SCAN_ZAP_ADD_QUERY_PARAM=off
# Passive baseline only: run Noir, seeding, spider and the passive queue, but
# skip the active scan. A different experiment from a full scan (its own digest).
#SCAN_ZAP_PASSIVE_ONLY=off
# Cap alerts per PASSIVE rule; 0 = unlimited. A cap suits a bounded CI report,
# not a run whose numbers are the result.
SCAN_ZAP_MAX_ALERTS_PER_RULE=-1
# Keep the run's ZAP session file after the scan (1 to keep). Every request and
# response of the scan lives in it, so the run can be reopened in ZAP Desktop.
# Gigabytes per run and not an artifact the pipeline reads — the default removes
# it so a long-lived daemon does not accumulate one session per scan.
SCAN_ZAP_KEEP_SESSION=off

# Reset the target to its clean, freshly-seeded state BEFORE the scan (the
# target stays persistent afterwards), via the target's own `env/reset.sh`. OFF
# by design: a persistent target models a permanent CI/CD staging environment,
# and the state prior authenticated scans accumulate in it (content, settings
# and the scanner's own footprint) is itself a finding. ON gives each scan a
# clean starting instance, so scan-volume variance is the scanner's, not
# accumulation's. A structural parameter: a reset run's config digest differs
# from a persistent one's.
SCAN_RESET_TARGET=off

# --- scan: Noir ---------------------------------------------------------
SCAN_NOIR_IMAGE=ghcr.io/owasp-noir/noir:1.2.1@sha256:5332bdb800dc281d4d7067aa14bd15986144f9121b92d7f466c02ba807b00103
# Run Noir static extraction + seeding (default on). Off = spider-only Phase-1
# behaviour, for the coverage-delta measurement.
SCAN_NOIR_ENABLED=on
# One-off override of the target's own source tree; unset by default.
#SCAN_NOIR_SOURCE_DIR=targets/gitea/src

# --- triage: the two LLM passes --------------------------------------
# Separate because the workloads are opposite. Pass 1 is ~74 small calls, so
# unit price and latency dominate and reasoning is a liability (it bills from
# the completion budget and causes truncation splits). Pass 2 is ONE call, so
# unit price barely matters and reasoning is the whole point — it is the one
# stage where an expensive model is affordable (~$0.09 for z-ai/glm-5.2,
# ~$0.20 for anthropic/claude-sonnet-5, per run).
# Each pass sets its OWN model; there is no bare "sets both" variable.
# OpenRouter credential for both triage passes and the verify loop — a
# PLACEHOLDER (see the credentials note at the top of this file). It has no CLI
# flag on purpose: a key on a command line lands in shell history and in `ps`.
SHARED_OPENROUTER_API_KEY=your-key
TRIAGE_SCREENING_MODEL=deepseek/deepseek-v4-flash-0731
TRIAGE_SYNTHESIS_MODEL=deepseek/deepseek-v3.2
# OpenRouter provider routing: ONE provider setting per model setting above (a
# plain provider slug, or a comma list). `none` (default) uses a routing
# PREFERENCE: only providers honouring the request's seed + strict structured
# output (require_parameters), sorted by throughput, privacy-respecting
# (data_collection=deny), fallbacks on. A value HARD-PINS that model to exactly
# those providers with fallbacks off (fully reproducible). TRIAGE_SYNTHESIS_PROVIDER
# also covers TRIAGE_SYNTHESIS_MODELS ensemble members.
TRIAGE_SCREENING_PROVIDER=none
TRIAGE_SYNTHESIS_PROVIDER=none
# Mark a cacheable stable prefix on the multi-turn model calls (synthesis's
# repeats, the verify loop's rounds, pull-mode retrieval). On by default. Caching
# changes no output — a hit returns the same tokens — so it is a billing/latency
# optimisation, which is why `0` exists to price it. → DECISIONS.md.
SHARED_PROMPT_CACHE=on

# Per-site switches, so the saving is attributable rather than aggregate. Each
# defaults to SHARED_PROMPT_CACHE above; set one to `off` to price that site alone.
#   triage     pass 1's system prompt (small calls, little to cache)
#   verify     the verification loop's rounds
#   retrieval  pull mode's tool-use loop
# Synthesis has no switch: the provider caches its identical prefixes by itself.
TRIAGE_PROMPT_CACHE=on
VERIFY_PROMPT_CACHE=on
TRIAGE_PROMPT_CACHE_RETRIEVAL=on

# Pass-1 calls in flight. 10 since 2026-11-02 (was 6); watch retried_calls and
# rate-limit failures in triage-metrics, and lower it if the pinned provider throttles.
TRIAGE_CONCURRENCY=10
# Run the cross-endpoint synthesis pass (pass 2). Off keeps pass-1 triage only.
TRIAGE_SYNTHESIS_ENABLED=on
# Cap the number of pass-1 model calls (0 = no cap). Cost control while iterating.
TRIAGE_MAX_ENDPOINTS=0
# Findings pass 1 asks beyond the old gate. Every finding of an endpoint with static
# context is asked; the rest are ranked by ZAP risk, then source before none, and the
# first N asked, the others recorded as deferred. 0 = the old gate only, -1 = all.
# A scope fixed before any call, so a repeat asks the same set. 250 keeps every
# non-informational finding of the logged-in WordPress smoke scan.
TRIAGE_MAX_UNMATCHED_FINDINGS=250
# Wall-clock limit on pass 1, in minutes: no call starts after it. A safety net set
# well above a normal run, not a scope; -1 removes it.
TRIAGE_SCREENING_MAX_MINUTES=60
# Drop php_pure endpoints under cli/ or install/ from the LLM arm — a framework-less
# PHP app's non-web scripts (Cacti), whose passive findings sit on a surface no HTTP
# client reaches. Off by default; the deterministic record still sees every endpoint.
TRIAGE_PRUNE_NONINTERACTIVE_PHP=off
# Preview only: write the prompts that would be sent and stop. Set deliberately —
# it turns a real triage into a no-op.
#TRIAGE_DRY_RUN=off
# How much each pass-1 call is told about its PEER endpoints — where the same rule fired:
#   none     one endpoint per call and nothing else — the A/B baseline
#   peers    the peer endpoints — where else in this scan the same rule fired
#   full     adds which of those routes run the same handler code
# `none` is kept so the effect of peer context can be measured, not asserted.
TRIAGE_PEER_CONTEXT=full
# Which config/excerpts/<name>.yml decides how much of each HTTP exchange
# reaches a prompt. The scan stores generously (a body dropped then cannot be
# recovered without re-scanning); this decides what is sent, which is strict
# because long irrelevant context degrades attention.
#   minimal   headers only, no body anywhere — the A/B floor
#   balanced  headers + a body slice sized to the rule class, centred on what
#             ZAP observed rather than taken from the top of the page
#   maximum   every class gets a body, ~3x the balanced window — the ceiling,
#             for asking whether `balanced` cut something the model needed
TRIAGE_HTTP_CONTEXT=balanced
# How much handler SOURCE each pass-1 call gets. Noir names the handler symbol;
# universal-ctags resolves it to a definition and one hop of same-package
# callees are read from the target's own tree.
#   none          the A/B baseline, NOT a fallback
#   handler       the resolved handler plus its hop bodies, raw
#   handler+trace the same handler source plus the call chain & where the
#                 flagged parameter literally appears in it
TRIAGE_CODE_CONTEXT=handler+trace
# Call hops out from the handler, and the per-endpoint line ceiling. The walk
# saturates after one hop: calls that would go further leave the handler tree.
TRIAGE_CODE_CONTEXT_MAX_HOPS=1
TRIAGE_CODE_CONTEXT_MAX_LINES=600
# How pass 1 GETS its evidence, as opposed to how much of it there is.
#   push  the assembler attaches the HTTP exchange and the handler source to
#         every prompt, whether the judgement needs them or not — the A/B
#         baseline, and the default
#   pull  a minimal pack plus a manifest of what is retrievable, and the model
#         asks the read-only context MCP server (mcp/context_server.py) for the
#         exchange or the source it actually wants
TRIAGE_RETRIEVAL=push
# Retrievals one pass-1 call may make before the tools are withdrawn and the
# model must answer with what it has. Only meaningful with TRIAGE_RETRIEVAL=pull.
# Small on purpose: the question is whether the model asks for the RIGHT
# evidence, and a generous budget answers a different one.
TRIAGE_RETRIEVAL_MAX_CALLS=6
# Starting number of an endpoint's alerts asked about in one pass-1 call
# (chunked, never dropped). Smaller batches trade more calls for fewer re-asks
# when a provider returns a short verdict list; the optimum is provider-dependent
# and measured, not fixed (see DECISIONS.md, "§R3.4 missing-verdicts re-ask").
TRIAGE_MAX_ALERTS_PER_CALL=6
# Cost ceilings, in USD. -1 means no ceiling, which is the default everywhere:
# a cap that fires part-way through leaves a run whose numbers are a lower bound
# on a question nobody asked. They exist to stop a *mistake* running all night,
# not to shape a result.
#   this stage's model calls
SHARED_STAGE_MAX_COST_USD=-1
#   every stage of one run, together (a later stage inherits the earlier spend).
#   Defaults to 1.00 rather than -1: ample headroom over a real run while still
#   stopping a runaway.
SHARED_RUN_MAX_COST_USD=1.0
# Run the LLM arm at all. `false` is the deterministic control arm — free, no
# key, and what a harness smoke row uses. `--no-llm` is the same switch typed.
TRIAGE_LLM_ENABLED=on
# Which prompt file each pass sends: prompts/<pass>/<pass>.v<N>.md. `none`/empty
# means the newest on disk — but ALL THREE passes are pinned below to the
# corpus's validated versions (screening 3, synthesis 5, verify 2), so a newer
# prompt landing never silently changes what a run does and an unpinned run stays
# consistent with the reported corpus. Two sheet rows differing only in one of
# these are a prompt A/B. See prompts/README.md.
# Screening pinned to 3: v4 was measured and REFUTED (sheet 05 — fewer flags at
# ~1.6x cost, no instance-level upside), and v5/v6 are later feature prompts (the
# code-context evidence rules, the retrieval section) never adopted as the general
# default. Adding a prompt file must not silently change what every run does.
TRIAGE_PROMPT_VERSION=3
# Independent whole-corpus synthesis calls, unioned by cited evidence. Sampling,
# not chunking: more repeats raise the chance of surfacing a cross-endpoint claim.
TRIAGE_SYNTHESIS_REPEATS=5
# Per-call wall-clock deadline for a synthesis request, in seconds. On the frozen
# model (deepseek/deepseek-v3.2) a completing whole-corpus call is usually fast —
# p50 ~45s, p90 ~2min across 522 recorded calls — but a slow-but-completing provider
# (AtlasCloud, Friendli) has legitimately taken up to ~59min (max observed 3526s) and
# still returned. This deadline is set ABOVE every completion ever observed, so it
# does NOT cut normal function on any target or provider; its only job is to bound a
# genuine STALL — a provider that accepts the ~135k-token request and never answers
# (one Cacti ceiling ran >182min before a read timeout). On expiry the pass is SKIPPED
# and recorded ("timeout"), pass-1 verdicts stand, and the chain continues to verify.
# 0 disables the deadline (the pre-2026-10-29 unbounded behaviour).
TRIAGE_SYNTHESIS_TIMEOUT_SECONDS=5400
# Pre-emptive synthesis cap, in prompt tokens: skip the whole-corpus pass WITHOUT
# attempting it when its estimated prompt is larger than this. 0 (the default)
# disables it — synthesis is always attempted, and a too-big corpus is handled at
# call time instead (a provider 400 narrows it; the deadline above bounds a stall).
# An opt-in size heuristic for a corpus known not to be worth a call, recorded
# distinctly as an `oversize` skip. NOT the stall guard — a corpus well within a
# provider's context window can still hang; that is the timeout's job.
TRIAGE_SYNTHESIS_MAX_PROMPT_TOKENS=0
# Draw the samples above from SEVERAL models instead of one — an ensemble.
# Comma-separated; `none` (the default) is the single-model behaviour. Each model
# draws TRIAGE_SYNTHESIS_REPEATS samples of the same corpus, so the union reports both
# per-model recurrence and how many MODELS reached each claim. Cross-model
# agreement is the stronger signal: repeats of one model share its failure
# modes. Total pass-2 calls is repeats x models, so this multiplies the cost.
TRIAGE_SYNTHESIS_MODELS=none
# Providers for the ensemble above, matched to it BY POSITION (a,,c leaves the
# middle model on the routing preference). A single provider cannot serve models
# from different vendors, so this is how a heterogeneous ensemble is pinned
# reproducibly. Count must equal TRIAGE_SYNTHESIS_MODELS' or synthesis is skipped
# with an error. `none` (the default) leaves every member on TRIAGE_SYNTHESIS_PROVIDER.
TRIAGE_SYNTHESIS_PROVIDERS=none
# Pinned to 5 — the corpus's version and the current synthesis prompt (v4 added
# the Phase-4 accountability classification, v5 the propagation route
# enumeration). `none` would float to the newest on disk; pinned for the same
# reason as TRIAGE_PROMPT_VERSION above.
TRIAGE_SYNTHESIS_PROMPT_VERSION=5

# --- oracle-guided mode (the detection ceiling) -------------------------
# Hand every LLM stage the target's documented vulnerabilities
# (targets/<name>/oracle.md) so the pipeline knows what it is looking for, then
# measure how much it still confirms. One switch for the whole chain — triage,
# synthesis and verification all read it — because a run where triage knew the
# answer and verification did not is neither a ceiling nor a blind run.
#
# What comes out is an UPPER BOUND on what this architecture could detect with
# perfect prior knowledge. It is not a detection rate, it never belongs in the
# same table as a blind run, and the gap between the two is the size of the
# "detectable but missed" set — which is the number the mode exists to produce.
# Every artifact from such a run carries `oracle_guided: true`.
SHARED_ORACLE=off

# --- verify: dispatch budget --------------------------------------------
VERIFY_TOOL_TIMEOUT_SECONDS=150
# Dispatch caps take -1 to mean NO LIMIT and 0 to mean none; every one at -1 is
# an exhaustive run, bounded only by VERIFY_TOOL_TIMEOUT_SECONDS per invocation.
VERIFY_MAX_DISPATCH_ALL_RULES=30
# Per-rule overrides, `ID=N` comma-separated (e.g. 40018=40,30002=5) — the same
# assignments the repeatable `--max-dispatch-rule ID=N` flag takes. `none` = no
# per-rule overrides.
VERIFY_MAX_DISPATCH_RULE=none
VERIFY_MAX_DISPATCHES_TOTAL=40
VERIFY_MAX_MINUTES=20
# The PROPAGATION DISPATCH, off by default. A cross-endpoint claim names the
# routes it predicts share a weakness; this goes and looks at the ones ZAP never
# flagged, and a confirmation there is a finding no part of the deterministic
# pipeline could reach. Set N > 0 to turn it on, capped at N sibling routes per
# claim so one broad claim cannot exhaust the budget the flagged findings share
# (3 is the sensible value).
#
# 0 by default, on purpose. It changes what a verify run CONTAINS — extra
# dispatches, a new `s-` finding class, its own report section, and a target the
# driver must reach over dast-net for the reachability pre-check — so a run with
# it is not comparable with one without. And it is unvalidated: two live runs,
# zero confirmations, and on the only corpus that exercises it not one probe
# reached the page its claim was about (5 routes did not exist, the other 7
# redirected an unauthenticated request to the login page). Turn it on for the
# experiment; leave it off for a baseline.
VERIFY_MAX_SIBLINGS=0

# --- Verification: one loop per finding ------------------------------------
# WHICH tool settles a finding is always the deterministic lookup keyed on the
# ZAP rule (the model-picks-the-tool option was removed 2026-11-02). The one axis
# left is HOW it is called, and when to stop asking. `llm` runs the round loop and
# is the default: every verdict-moving fix in this project's history was about
# invocation, never tool choice. `deterministic` is the fixed single-shot probe —
# the FULLY-DETERMINISTIC configuration, no key, no spend, and the control every
# LLM configuration is measured against.
VERIFY_INVOCATION=llm
# Rounds one loop may run before it must conclude: propose, react, refine.
# Ignored under VERIFY_INVOCATION=deterministic, which is single-shot by nature.
# With the per-run cost ceiling, this is what bounds the loop's spend.
VERIFY_MAX_ROUNDS=3
# How the loop gets the handler source: push (attach what was pre-resolved) or
# pull (also let the model ask the read-only context server for more, mid-loop —
# the same arm triage's pull uses). Only applies under VERIFY_INVOCATION=llm.
VERIFY_RETRIEVAL=push
# Retrievals one finding's loop may make before the tools are withdrawn and the
# model must conclude. Only meaningful with VERIFY_RETRIEVAL=pull.
VERIFY_RETRIEVAL_MAX_CALLS=6
# The ONE model the whole loop uses — every round's invocation proposal and its
# final category. Falls back to OPENROUTER_MODEL when empty. An immutable id,
# never a floating alias: a re-run whose weights moved is not a reproduction.
# `minimax-m2.5` needs no date — it is its own OpenRouter entry and a version bump
# mints a new id. Floating ids (the `~...-latest` ones, bare family names) are
# what to refuse.
VERIFY_MODEL=minimax/minimax-m2.5
# Provider for the verify model (the sibling of VERIFY_MODEL) — a plain slug or
# comma list. `none` uses the throughput/require-parameters preference; a value
# hard-pins with fallbacks off. Independent of the triage-stage providers.
VERIFY_PROVIDER=none
# Which prompts/verify/verify.v<N>.md the loop sends. Pinned to 2 — the corpus's
# version. v2 named what the declared signal is checked against; v3 only adds the
# rule against predicting a word from the tool's own output FORMAT, which is also
# enforced mechanically (verification.OUTPUT_FORMAT_WORDS), so it moves no verdict.
# `none` would float to the newest on disk (v3); pinned for consistency.
VERIFY_PROMPT_VERSION=2
# Preview only: print the dispatch plan and round-1 prompts and stop. Set
# deliberately — it turns a real verify into a no-op.
#VERIFY_DRY_RUN=off

# The ORACLE-SEEDED verify dispatch, off by default and oracle-mode only. When a
# target's documented ground-truth marker (cve-markers.yml) raised no ZAP finding
# — so nothing routed a dispatch to its sink — this synthesises one FROM THE
# MARKER: the sink URL, the tool the rescan table routes the marker's own rule to,
# and the marker's `auth`. It exists to confirm a documented CVE whose in-band ZAP
# reach is budget-bound (Cacti's CVE-2022-46169 at the authenticated ceiling,
# where the active-scan cap cannot reach remote_agent.php's poller_id on the full
# crawl). A LABELED ADDITIONAL verify configuration, never the baseline: it is
# gated on --oracle so it can NEVER touch a blind run, its verdict still resolves
# through verification.resolve_verdict (class gate included), and its record
# carries a distinct origin (never counted with the blind detections). Off by
# default, so the frozen baseline's artifacts are byte-identical without it.
VERIFY_ORACLE_SEED_DISPATCH=off

# --- verify: tools ------------------------------------------------------
VERIFY_NUCLEI_TEMPLATES_VOLUME=nuclei-home
# Out-of-band (OAST). Self-hosted sink only — never the public oast.pro pool.
VERIFY_OOB=off
VERIFY_INTERACTSH_SERVER=http://target-interactsh:8080
VERIFY_INTERACTSH_COOLDOWN_SECONDS=10

# --- static-analysis: SAST + SCA findings -----------------------
# Restrict to one pass: `sast` or `sca`. Empty runs both.
#STATIC_ANALYSIS_ONLY=
# Preview only: print the container invocations and stop. Set deliberately.
#STATIC_ANALYSIS_DRY_RUN=off
